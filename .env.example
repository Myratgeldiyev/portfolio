# Public URL of the site (used for SEO, sitemap, OG image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres connection string (Transaction pooler, port 6543)
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Resend (https://resend.com/api-keys). Leave empty to skip email notifications.
RESEND_API_KEY=
CONTACT_TO_EMAIL=deluxlos06@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Random string used to hash visitor IPs for rate limiting (openssl rand -hex 32)
IP_HASH_SALT=change-me

# Umami analytics (optional)
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
